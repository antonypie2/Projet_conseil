# Copiez ce fichier en .env et renseignez vos clés (toutes gratuites) :
# Finnhub      : https://finnhub.io/register
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
# Gemini (Google), sans carte bancaire : https://aistudio.google.com/apikey
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
GEMINI_API_KEY=

# Origine autorisée pour les requêtes CORS depuis le frontend (Vite dev server).
CORS_ORIGIN=http://localhost:5173
