# Copiez ce fichier en .env et renseignez vos clés (toutes gratuites) :
# Finnhub      : https://finnhub.io/register
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
# Gemini (Google), sans carte bancaire : https://aistudio.google.com/apikey
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
GEMINI_API_KEY=

# Origine autorisée pour les requêtes CORS depuis le frontend (Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Optionnel en local (sans cette variable, un fichier SQLite local est utilisé).
# Obligatoire en production sur Vercel : chaîne de connexion Postgres gratuite
# (Neon https://neon.tech ou Supabase https://supabase.com). Sur Neon, utilisez
# la "pooled connection string" (via PgBouncer) plutôt que la connexion directe
# — indispensable en serverless pour ne pas épuiser les connexions Postgres.
DATABASE_URL=
